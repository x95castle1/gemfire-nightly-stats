# Settings for NightlyStatsLocatorStart. Copy this file, then run:
#   scripts/start-locator.sh <your copy>

# Values provided at setup (GemFire doesn't know them). Both are required.
ENV=local
CLUSTER_NAME=sample-cluster

# Locator
LOCATOR_PORT=10334
# Working directory for the locator's files and log. Created if missing. Required.
LOG_DIRECTORY=/tmp/gemfire-logs
JMX_MANAGER_PORT=1099
# Address to bind to. Default: all addresses.
# BIND_ADDR=
# Default: <CLUSTER_NAME>-locator-<LOCATOR_PORT>
# MEMBER_NAME=

# Nightly stats
# Where the daily JSON files go. Default: <LOG_DIRECTORY>/nightly-stats
# NIGHTLY_STATS_DIR=
# Local time of the daily run, HH:mm
NIGHTLY_STATS_TIME=02:00
# Also run once, 60 seconds after startup (handy for testing)
NIGHTLY_STATS_RUN_ON_STARTUP=false

# Any other GemFire property can be passed with a "gemfire." prefix. For example, SSL:
# gemfire.ssl-enabled-components=all
# gemfire.ssl-protocols=TLSv1.2,TLSv1.3
# gemfire.ssl-keystore=/path/to/locator.keystore
# gemfire.ssl-keystore-password=changeit
# gemfire.ssl-keystore-type=PKCS12
# gemfire.ssl-truststore=/path/to/locator.truststore
# gemfire.ssl-truststore-password=changeit
# gemfire.ssl-truststore-type=PKCS12
