# Local development only. Copy to .env and replace the example passwords.
# Keep this file Bash-compatible so the host collector can use the same credentials:
#   set -a; source .env; set +a
AWS_ACCESS_KEY_ID=nightly-stats
AWS_SECRET_ACCESS_KEY=local-development-secret-change-me
# The local collector uses the credentials above, without workstation AWS profiles.
AWS_CONFIG_FILE=/dev/null
AWS_SHARED_CREDENTIALS_FILE=/dev/null
WEED_ADMIN_USER=admin
WEED_ADMIN_PASSWORD=local-development-password-change-me
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ADMIN_PORT=23646
NIGHTLY_STATS_S3_BUCKET=gemfire-nightly-stats
