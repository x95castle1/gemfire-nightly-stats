# Local SeaweedFS settings for docker-compose.yml and the Makefile. `make s3-up` copies this to
# .env (ignored by git) on first use; change the passwords there. No quotes around values.
# S3 keys SeaweedFS accepts, and that `make test S3=true` gives the collector
AWS_ACCESS_KEY_ID=nightly-stats-dev
AWS_SECRET_ACCESS_KEY=change-me-local-s3-secret
# Admin UI login (http://localhost:23646)
WEED_ADMIN_USER=admin
WEED_ADMIN_PASSWORD=change-me-local-admin-password
# Created on startup if missing
S3_BUCKET=gemfire-stats
