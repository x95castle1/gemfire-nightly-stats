# Standalone collector: connect to an EXISTING cluster's JMX manager.
# Copy to standalone.properties, edit, then run:
#   scripts/collect-stats.sh collect --config standalone.properties
# Run from this example directory. In an unpacked distribution, use bin/collect-stats.sh instead.
ENV=local
CLUSTER_NAME=sample-cluster
JMX_HOST=localhost
# JMX manager port, NOT the locator's discovery port (usually 10334).
JMX_PORT=1099
# Total budget for the JMX connection, collection and closing the connection.
JMX_TIMEOUT_SECONDS=120

# Optional authentication. Credentials are read only from this properties file.
# JMX_USERNAME=reader
# JMX_PASSWORD=
# Alternatively, a bearer token (cannot be combined with username/password):
# JMX_TOKEN=

# The report directory is <REPORT_DIR>/<ENV>/<CLUSTER_NAME>.
# Relative paths are resolved from the command's working directory.
REPORT_DIR=reports
# Timezone for the unique filename timestamp and its export-filter date.
# Default: the collector machine's timezone. Does not change the UTC collected_at field.
# REPORT_TIMEZONE=America/Toronto
# Warn when storage has less than this many MiB available. Reports are never automatically deleted.
MIN_FREE_SPACE_MB=100

# local is the default: save reports, with no S3 configuration, credentials or requests.
# Change to s3 when the destination is ready; upload-pending backfills existing reports without JMX.
DELIVERY_MODE=s3
# In s3 mode, false means a saved report is a successful collection even if upload fails.
# true returns exit 4 if upload fails or pending reports remain after the bounded pass.
UPLOAD_REQUIRED=false
# S3_ENDPOINT=http://localhost:8333
# S3_BUCKET=gemfire-stats
# S3_REGION=us-east-1
# S3_PREFIX=nightly-stats
# S3 credentials are read only from this properties file.
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# For SSL/mutual TLS on the JMX connection, use GemFire's client SSL properties.
# These settings are independent of S3 HTTPS, which uses the JVM's default truststore.
# gemfire.ssl-enabled-components=jmx
# gemfire.ssl-endpoint-identification-enabled=true
# gemfire.ssl-protocols=TLSv1.2,TLSv1.3
# gemfire.ssl-keystore=/path/to/client.p12
# gemfire.ssl-keystore-type=PKCS12
# gemfire.ssl-keystore-password=
# gemfire.ssl-truststore=/path/to/truststore.p12
# gemfire.ssl-truststore-type=PKCS12
# gemfire.ssl-truststore-password=
