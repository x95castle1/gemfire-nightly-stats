# Settings for NightlyStatsLocatorStart. Copy this file, then run:
#   scripts/start-locator.sh <your copy>  (from this example directory)
# In an unpacked distribution: bin/start-locator.sh <your copy>

# Values provided at setup (GemFire doesn't know them). Both are required.
ENV=local
CLUSTER_NAME=sample-cluster

# Locator
LOCATOR_PORT=10334
# Working directory for the locator's files and log. Created if missing. Required.
LOG_DIRECTORY=/tmp/gemfire-logs
JMX_MANAGER_PORT=1099
# Address to bind to. Default: 0.0.0.0 (all addresses).
BIND_ADDR=0.0.0.0
LOCATOR_HOST_NAME_FOR_CLIENTS=localhost
# Default: <CLUSTER_NAME>.<BIND_ADDR>.locator<LOCATOR_PORT>, as in CitiGemFireLocatorStart.
# MEMBER_NAME=
# The Citi startup also starts a CacheServer in the locator JVM. Default: 40404.
# Use 0 for an automatically assigned port.
CACHE_SERVER_PORT=40404

# CitiGemFireLocatorStart SSL settings. Empty CLUSTER_SSL_ENABLED disables SSL.
# For SSL set it to all (or the required components) and provide the store path/password.
CLUSTER_SSL_ENABLED=
CLUSTER_SSL_PROTOCOLS=any
CLUSTER_SSL_MUTUAL_AUTHENTICATION=true
CLUSTER_SSL_CIPHERS=any
# The Citi configuration uses the same file and password for keystore and truststore.
CLUSTER_SSL_KEY_STORE_FILE_NAME=
# Supply the usable password directly; the reference CitiGemFireUtils.decrypt is a placeholder.
CLUSTER_SSL_KEY_STORE_PASSWORD=
SSL_USE_DEFAULT_CONTEXT=false

# Nightly stats
# Where the individual timestamped JSON files go. Default: <LOG_DIRECTORY>/nightly-stats
# NIGHTLY_STATS_DIR=
# Local time of the daily run, HH:mm
NIGHTLY_STATS_TIME=02:00
# Also run once, 60 seconds after startup (handy for testing)
NIGHTLY_STATS_RUN_ON_STARTUP=false
# Optional demo interval in seconds: 60 repeats every minute after the previous run completes.
# 0 keeps the daily schedule above. A positive value replaces the daily schedule.
COLLECTION_INTERVAL_SECONDS=0

# Upload each report to an S3-compatible store (SeaweedFS, MinIO, AWS S3) as well as writing it to
# disk. Off unless S3_ENDPOINT is set. The object key is <S3_PREFIX>/<ENV>/<CLUSTER_NAME>/<file name>.
# docker-compose.yml runs a local SeaweedFS that matches these values.
# S3_ENDPOINT=http://localhost:8333
# S3_BUCKET=gemfire-stats
# Default: us-east-1. SeaweedFS and MinIO accept any value.
# S3_REGION=us-east-1
# Default: nightly-stats
# S3_PREFIX=nightly-stats
# Default: the AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY environment variables
# S3_ACCESS_KEY=nightly-stats-dev
# S3_SECRET_KEY=nightly-stats-dev-secret

# GemFire properties with a "gemfire." prefix override the Citi settings above. For example, SSL:
# gemfire.ssl-enabled-components=all
# gemfire.ssl-protocols=TLSv1.2,TLSv1.3
# gemfire.ssl-keystore=/path/to/locator.keystore
# gemfire.ssl-keystore-password=changeit
# gemfire.ssl-keystore-type=PKCS12
# gemfire.ssl-truststore=/path/to/locator.truststore
# gemfire.ssl-truststore-password=changeit
# gemfire.ssl-truststore-type=PKCS12
